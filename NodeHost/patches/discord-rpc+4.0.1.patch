+function getIPCAtPath(path) {
+  return new Promise((resolve, reject) => {
+    const onerror = () => {
+      reject(new Error(`Could not connect to ${path}`));
+    };
+    const sock = net.createConnection(path, () => {
+      sock.removeListener('error', onerror);
+      resolve(sock);
+    });
+    sock.once('error', onerror);
+  });
+}
